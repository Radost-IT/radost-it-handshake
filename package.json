{
  "name": "radost-it-handshake",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web && tsc --noEmit -p infra",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "pnpm --filter @handshake/web dev",
    "cdk:synth": "pnpm --filter @handshake/web build:aws && pnpm --filter @handshake/infra exec cdk synth",
    "cdk:deploy": "pnpm --filter @handshake/web build:aws && pnpm --filter @handshake/infra exec cdk deploy",
    "probe:paypal": "tsx --env-file=.env scripts/probes/paypal-auth.ts",
    "probe:channel3": "tsx --env-file=.env scripts/probes/channel3-search.ts",
    "probe:bedrock": "tsx --env-file=.env scripts/probes/bedrock-hello.ts",
    "probe:paypal-limits": "tsx --env-file=.env scripts/probes/paypal-authorization-limits.ts",
    "probe:paypal-payout": "tsx --env-file=.env scripts/probes/paypal-payout.ts",
    "ssm:put": "tsx --env-file=.env scripts/put-ssm-parameters.ts",
    "regressions:export": "tsx scripts/export-regressions.ts",
    "arena:access": "tsx --env-file=.env scripts/arena-access.ts",
    "api-keys:create": "tsx scripts/create-api-key.ts",
    "accounts:judges": "tsx scripts/create-judge-accounts.ts",
    "mcp": "tsx --env-file-if-exists=.env packages/mcp/src/main.ts",
    "seed:sellers": "tsx --env-file=.env scripts/seed-sellers.ts",
    "seed:template-sellers": "tsx scripts/seed-template-sellers.ts",
    "demo:reset": "tsx --env-file=.env scripts/demo-reset.ts",
    "eval": "tsx --env-file=.env scripts/run-evals.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
