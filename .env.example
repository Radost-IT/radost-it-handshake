# Local configuration. Copy to .env and fill in real values. Never commit .env.
# On AWS the same values live in SSM under /handshake/<stage>/ (see INSTRUCTIONS.md [I-10]).

# PayPal sandbox app (developer.paypal.com > Apps & Credentials, Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must be the sandbox URL; anything else fails config validation.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from [I-11]; leave empty until the webhook is registered.
PAYPAL_WEBHOOK_ID=

# Channel3 API key (trychannel3.com/developers).
CHANNEL3_API_KEY=

# Bedrock region and inference profile IDs from [I-8].
BEDROCK_REGION=eu-west-1
BEDROCK_MODEL_FAST=eu.anthropic.claude-sonnet-5-5
BEDROCK_MODEL_SMART=eu.anthropic.claude-opus-5-5

# LLM tokens allowed per day across all deals.
DAILY_TOKEN_BUDGET=2000000
# Maximum messages per negotiation.
NEGOTIATION_MAX_TURNS=8

# ACM certificate ARNs for *.radostit.com from [I-10]. Only `pnpm ssm:put` reads these;
# CDK takes them from SSM at deploy time. CloudFront needs the us-east-1 one.
CERTIFICATE_ARN_US_EAST_1=
CERTIFICATE_ARN_EU_WEST_1=
