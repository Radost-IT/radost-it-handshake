# Local configuration. Copy to .env and fill in real values. Never commit .env.
# On AWS the same values live in SSM under /handshake/<stage>/ (see INSTRUCTIONS.md [I-10]).

# PayPal sandbox app (developer.paypal.com > Apps & Credentials, Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must be the sandbox URL; anything else fails config validation.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from [I-11]; leave empty until the webhook is registered.
PAYPAL_WEBHOOK_ID=
# Hours PayPal guarantees a new authorization before it must be reauthorized.
# 72 per the PayPal docs; replace it with the value `pnpm probe:paypal-limits` measures.
PAYPAL_HONOR_PERIOD_HOURS=72

# Channel3 API key (trychannel3.com/developers). Optional: only product search and
# `pnpm seed:sellers` need it, so it can stay empty while the account is pending.
CHANNEL3_API_KEY=

# Bedrock region and inference profile IDs from [I-8].
BEDROCK_REGION=eu-west-1
BEDROCK_MODEL_FAST=eu.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_SMART=eu.anthropic.claude-opus-4-6-v1

# LLM tokens allowed per day across all deals.
DAILY_TOKEN_BUDGET=200000
# Maximum messages per negotiation.
NEGOTIATION_MAX_TURNS=8
# Largest single arena bounty and the most all bounties may pay per day, in USD.
MAX_BOUNTY=5.00
DAILY_BOUNTY_BUDGET=50.00
# Email of the arena bounty recipient sandbox account from [I-4]. Bounties go only here.
ARENA_RECIPIENT_EMAIL=
# Where arena deals come from: templates (fixed deals) or sellers (seeded from Channel3
# with `pnpm seed:sellers`). Defaults to templates.
ARENA_DEAL_SOURCE=templates
# Sender of arena sign-in codes and access emails. Its domain must be verified in SES ([I-22]).
ARENA_EMAIL_FROM=arena@handshake.radostit.com
# Receives every request to join the arena, with the reason and the approve command.
ARENA_ADMIN_EMAIL=

# ACM certificate ARNs for *.radostit.com from [I-10]. Only `pnpm ssm:put` reads these;
# CDK takes them from SSM at deploy time. CloudFront needs the us-east-1 one.
CERTIFICATE_ARN_US_EAST_1=
CERTIFICATE_ARN_EU_WEST_1=
# Route 53 hosted zone ID of radostit.com (starts with Z). CDK adds the
# handshake and api-handshake records to this zone. Only `pnpm ssm:put` reads it.
HOSTED_ZONE_ID=

# Signs the spam challenge and attempt cookie of the web contact and newsletter
# forms. Generate with `openssl rand -hex 32`. Only the web server reads it.
FORM_SIGNING_SECRET=
